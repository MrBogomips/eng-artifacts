{
  "title": "A library on one afternoon",
  "description": "One branch and its catalogue, three members, copies of two books, an active and an overdue loan, a reservation queue and the loan states.",
  "packages": [
    { "id": "people", "label": "people" },
    { "id": "catalogue", "label": "catalogue" },
    { "id": "lending", "label": "lending" }
  ],
  "objects": [
    { "id": "central", "class": "Branch", "name": "central",
